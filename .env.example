# Meta Model API key from https://dev.meta.ai — key NAME only lives here, never a value.
# The app calls SAM 3.1 and Muse Spark with this at runtime.
MODEL_API_KEY=

# Optional overrides. Defaults shown.
# META_BASE_URL=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3
# SAM_MODEL=sam-3.1

# How long a bundled sample may spend in live analysis before its cached result
# is served instead, in milliseconds. 0 waits for the live run however long it
# takes. Only applies to the three bundled samples.
# SAMPLE_DEADLINE_MS=45000

# Hard ceiling on any single analysis, in milliseconds. Nothing enforces
# maxDuration when the server runs itself, so this does.
# ANALYZE_BUDGET_MS=150000
